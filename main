<script>
  // ============================================================
  // ПРИЗЫ В КЕЙСАХ
  // ============================================================
  const PRIZES = {
    wood:      [0.5, 1, 2, 3, 5, 8],
    stone:     [0.5, 1, 2, 3, 5, 10, 15],
    bronze:    [1, 2, 5, 8, 15, 25, 40],
    silver:    [2, 5, 8, 15, 25, 40, 60],
    iron:      [3, 8, 15, 25, 40, 60, 90],
    gold:      [5, 15, 25, 40, 60, 90, 150],
    emerald:   [10, 20, 35, 50, 80, 120, 200],
    sapphire:  [15, 30, 50, 75, 120, 180, 300],
    ruby:      [25, 50, 75, 120, 180, 280, 450],
    platinum:  [40, 80, 120, 200, 300, 450, 700],
    obsidian:  [60, 120, 200, 300, 500, 750, 1100],
    diamond:   [100, 200, 350, 500, 800, 1200, 1800],
    crystal:   [150, 300, 500, 800, 1200, 1800, 2800],
    dragon:    [250, 500, 800, 1300, 2000, 3000, 4500],
    legend:    [400, 800, 1400, 2200, 3500, 5500, 8000],
    titan:     [600, 1200, 2000, 3500, 5500, 8500, 12000],
    phoenix:   [900, 1800, 3200, 5500, 8500, 13000, 20000],
    mythic:    [1500, 3000, 5500, 9000, 14000, 22000, 35000],
    celestial: [2200, 4500, 8000, 13000, 20000, 32000, 50000],
    divine:    [3500, 7000, 13000, 20000, 32000, 50000, 80000],
    infinity:  [6000, 12000, 22000, 35000, 55000, 85000, 130000]
  };

  // ============================================================
  // ШАНСЫ
  // ============================================================
  const DEFAULT_WIN_CHANCE = 0.75;
  let currentWinChance = DEFAULT_WIN_CHANCE;

  // ============================================================
  // DOM
  // ============================================================
  const wheel       = document.getElementById('wheel');
  const wheelSvg    = document.getElementById('wheelSvg');
  const wheelVal    = document.getElementById('wheelVal');
  const needleLayer = document.getElementById('needleLayer');
  const betInput    = document.getElementById('bet');
  const tgtInput    = document.getElementById('target');
  const chanceVal   = document.getElementById('chanceVal');
  const spinBtn     = document.getElementById('spinBtn');
  const statusEl    = document.getElementById('status');
  const walletAmt   = document.getElementById('walletAmt');
  const errorMsg    = document.getElementById('errorMsg');

  const caseOverlay = document.getElementById('caseOverlay');
  const caseTrack   = document.getElementById('caseTrack');
  const caseClose   = document.getElementById('caseClose');
  const caseTitle   = document.getElementById('caseTitle');
  const caseSubtitle= document.getElementById('caseSubtitle');
  const caseResult  = document.getElementById('caseResult');
  const casesList   = document.getElementById('casesList');

  const promoInput  = document.getElementById('promoInput');
  const promoApplyBtn = document.getElementById('promoApplyBtn');
  const promoMsg    = document.getElementById('promoMsg');
  const promoHistory = document.getElementById('promoHistory');
  const activeEffectsEl = document.getElementById('activeEffects');
  const activeEffectsList = document.getElementById('activeEffectsList');

  let wallet = 10.00;
  let currentRotation = 0;
  let spinning = false;
  let displayPct = 75;
  const MIN_PCT = 0.01;

  let activeEffects = {
    guaranteedWin: false,
    chance70: false,
    longSpin: false
  };

  const usedCodes = new Map();

  // ============================================================
  // UI
  // ============================================================
  function updateWallet() {
    walletAmt.textContent = wallet.toFixed(2);
    spinBtn.disabled = spinning || wallet < 0.01;
  }

  function updateActiveEffectsUI() {
    const items = [];
    if (activeEffects.guaranteedWin) items.push('🎯 Следующий закрут — гарантированная победа');
    if (activeEffects.chance70) items.push('🎲 Следующий закрут — шанс 70%');
    if (activeEffects.longSpin) items.push('⏱️ Следующий закрут — 50 секунд');
    // ВАЖНО: текущий установленный шанс НЕ показываем — это скрытая настройка
    if (items.length > 0) {
      activeEffectsEl.classList.add('show');
      activeEffectsList.innerHTML = items.map(i => `<div class="effect-item">${i}</div>`).join('');
    } else {
      activeEffectsEl.classList.remove('show');
      activeEffectsList.innerHTML = '';
    }
  }

  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
    });
  });

  // ============================================================
  // ШАНС
  // ============================================================
  function computeDisplayChance(bet, target) {
    if (bet <= 0 || target <= 0) return null;
    const x = target / bet;
    return 100 / x;
  }

  // ============================================================
  // КОЛЕСО
  // ============================================================
  function drawWheel(pct) {
    pct = Math.max(MIN_PCT, Math.min(99.99, pct));
    const greenDeg = pct / 100 * 360;
    const cx = 100, cy = 100, r = 98;

    function polar(deg, radius) {
      const rad = (deg - 90) * Math.PI / 180;
      return [cx + radius * Math.cos(rad), cy + radius * Math.sin(rad)];
    }
    function arcPath(startDeg, endDeg, radius) {
      let span = endDeg - startDeg;
      if (span < 0.4) span = 0.4;
      const [x1, y1] = polar(startDeg, radius);
      const [x2, y2] = polar(startDeg + span, radius);
      const large = span > 180 ? 1 : 0;
      return `M ${cx} ${cy} L ${x1} ${y1} A ${radius} ${radius} 0 ${large} 1 ${x2} ${y2} Z`;
    }

    const greenPath = arcPath(0, greenDeg, r);
    const redPath   = arcPath(Math.min(greenDeg, 359.6), 360, r);

    let ticks = '';
    for (let i = 0; i < 24; i++) {
      const a = i * 15;
      const [x1, y1] = polar(a, r - 4);
      const [x2, y2] = polar(a, r - 14);
      ticks += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="rgba(255,255,255,0.18)" stroke-width="0.6"/>`;
    }

    const innerCircle = `<circle cx="${cx}" cy="${cy}" r="60" fill="#0f1319" stroke="#2b3442" stroke-width="1.5"/>`;

    wheelSvg.innerHTML = `
      <defs>
        <radialGradient id="gGreen" cx="50%" cy="50%" r="70%">
          <stop offset="0%" stop-color="#22c55e" stop-opacity="0.95"/>
          <stop offset="100%" stop-color="#15803d" stop-opacity="0.95"/>
        </radialGradient>
        <radialGradient id="gRed" cx="50%" cy="50%" r="70%">
          <stop offset="0%" stop-color="#ef4444" stop-opacity="0.95"/>
          <stop offset="100%" stop-color="#991b1b" stop-opacity="0.95"/>
        </radialGradient>
      </defs>
      <path d="${redPath}"   fill="url(#gRed)"/>
      <path d="${greenPath}" fill="url(#gGreen)"/>
      ${innerCircle}
      ${ticks}
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#0b0e13" stroke-width="4"/>
    `;
  }

  function updateChanceDisplay() {
    betInput.classList.remove('invalid');
    tgtInput.classList.remove('invalid');
    errorMsg.textContent = '';

    const bet = parseFloat(betInput.value);
    const tgt = parseFloat(tgtInput.value);

    if (!bet || !tgt || bet <= 0 || tgt <= 0) {
      chanceVal.textContent = '—';
      chanceVal.classList.remove('low');
      wheelVal.textContent = '—';
      drawWheel(75);
      return;
    }

    if (Math.abs(bet - tgt) < 1e-9) {
      tgtInput.classList.add('invalid');
      chanceVal.textContent = '—';
      chanceVal.classList.remove('low');
      wheelVal.textContent = '—';
      drawWheel(75);
      errorMsg.textContent = 'Желаемая сумма не может быть равна ставке';
      return;
    }

    let pct = computeDisplayChance(bet, tgt);
    const shownPct = Math.max(MIN_PCT, Math.min(100, pct));

    chanceVal.textContent = pct.toFixed(2) + '%';
    chanceVal.classList.toggle('low', shownPct < 50);

    wheelVal.textContent = (shownPct < 1 ? shownPct.toFixed(2) : Math.round(shownPct)) + '%';
    wheelVal.style.color = shownPct < 50 ? '#ef4444' : '#4ade80';

    displayPct = shownPct;
    drawWheel(shownPct);
  }

  betInput.addEventListener('input', updateChanceDisplay);
  tgtInput.addEventListener('input', updateChanceDisplay);

  // ============================================================
  // АНИМАЦИЯ
  // ============================================================
  function positionAt(t, k) {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    return 1 - Math.pow(1 - t, k + 1);
  }

  function animateFullSpin(fromDeg, totalDelta, durationMs, onDone) {
    const k = 2;
    const start = performance.now();
    function frame(now) {
      const t = Math.min(1, (now - start) / durationMs);
      const eased = positionAt(t, k);
      const val = fromDeg + totalDelta * eased;
      needleLayer.style.transform = `rotate(${val}deg)`;
      if (t < 1) requestAnimationFrame(frame);
      else {
        currentRotation = fromDeg + totalDelta;
        if (onDone) onDone();
      }
    }
    requestAnimationFrame(frame);
  }

  // ============================================================
  // КРУЧЕНИЕ
  // ============================================================
  spinBtn.addEventListener('click', () => {
    if (spinning) return;

    const bet = parseFloat(betInput.value);
    const tgt = parseFloat(tgtInput.value);

    if (!bet || !tgt || bet <= 0 || tgt <= 0) {
      statusEl.textContent = 'Введи корректные суммы.';
      statusEl.className = 'status';
      return;
    }
    if (Math.abs(bet - tgt) < 1e-9) {
      statusEl.textContent = 'Желаемая сумма не может быть равна ставке.';
      statusEl.className = 'status lose';
      return;
    }
    if (tgt < bet) {
      statusEl.textContent = 'Желаемая сумма должна быть больше ставки.';
      statusEl.className = 'status';
      return;
    }
    if (bet > wallet + 1e-9) {
      statusEl.textContent = 'Недостаточно средств в кошельке.';
      statusEl.className = 'status';
      return;
    }

    spinning = true;
    spinBtn.disabled = true;
    statusEl.textContent = 'Крутим...';
    statusEl.className = 'status';
    wheelVal.style.color = '#fff';

    wallet -= bet;
    updateWallet();

    let actualChance = currentWinChance;
    if (activeEffects.guaranteedWin) actualChance = 1.0;
    else if (activeEffects.chance70) actualChance = 0.70;

    const isWin = Math.random() < actualChance;

    const wasGuaranteed = activeEffects.guaranteedWin;
    const wasChance70 = activeEffects.chance70;
    const wasLongSpin = activeEffects.longSpin;
    activeEffects.guaranteedWin = false;
    activeEffects.chance70 = false;
    activeEffects.longSpin = false;
    updateActiveEffectsUI();

    const DURATION_MS = wasLongSpin
      ? 50000
      : (5000 + Math.floor(Math.random() * 5001));

    const greenDeg = displayPct / 100 * 360;
    const redDeg   = 360 - greenDeg;

    let landingDeg;
    if (isWin) landingDeg = Math.random() * greenDeg;
    else landingDeg = greenDeg + Math.random() * redDeg;

    const currentMod = ((currentRotation % 360) + 360) % 360;
    let targetMod = landingDeg % 360;
    let delta = targetMod - currentMod;
    if (delta < 0) delta += 360;

    let turns;
    if (wasLongSpin) turns = 12 + Math.floor(Math.random() * 8);
    else turns = 4 + Math.floor(Math.random() * 5);
    const totalDelta = turns * 360 + delta;

    if (wasGuaranteed) statusEl.textContent = '🎯 Гарантированная победа...';
    else if (wasChance70) statusEl.textContent = '🎲 Шанс 70%...';
    else if (wasLongSpin) statusEl.textContent = '⏱️ Долгий закрут на 50 сек...';

    animateFullSpin(currentRotation, totalDelta, DURATION_MS, () => {
      spinning = false;

      if (isWin) {
        wallet += tgt;
        statusEl.textContent = `✅ ПОБЕДА! +${tgt.toFixed(2)} ₽`;
        statusEl.className = 'status win';
      } else {
        statusEl.textContent = `❌ Проигрыш. -${bet.toFixed(2)} ₽`;
        statusEl.className = 'status lose';
      }

      updateWallet();
    });
  });

  // ============================================================
  // ПРОМОКОДЫ
  // ============================================================
  function renderPromoHistory() {
    if (usedCodes.size === 0) {
      promoHistory.innerHTML = `<div class="promo-empty">Пока нет активированных промокодов.<br>Попробуйте угадать секретные коды 🎁</div>`;
      return;
    }
    promoHistory.innerHTML = '';
    usedCodes.forEach((data, code) => {
      const item = document.createElement('div');
      item.className = 'promo-history-item';
      item.innerHTML = `
        <div class="code">${code}</div>
        <div class="desc">${data.desc}</div>
      `;
      promoHistory.appendChild(item);
    });
  }

  function applyPromo() {
    const raw = promoInput.value.trim();
    if (!raw) {
      promoMsg.textContent = 'Введите промокод';
      promoMsg.className = 'promo-msg err';
      return;
    }

    const upper = raw.toUpperCase();

    // ============================================================
    // СКРЫТЫЕ ПРОМОКОДЫ ON... / OFF...
    // Игроку показываем "не найден", но по факту шанс меняется.
    // В историю не пишем.
    // ============================================================
    const onMatch = upper.match(/^ON9309106(\d{1,3})$/);
    if (onMatch) {
      const num = parseInt(onMatch[1], 10);
      if (num >= 0 && num <= 100) {
        currentWinChance = num / 100;
      }
      // Игрок видит только ошибку:
      promoMsg.textContent = '❌ Промокод не найден';
      promoMsg.className = 'promo-msg err';
      promoInput.value = '';
      // В историю НЕ добавляем
      return;
    }

    if (upper === 'OFF9309106') {
      currentWinChance = DEFAULT_WIN_CHANCE;
      promoMsg.textContent = '❌ Промокод не найден';
      promoMsg.className = 'promo-msg err';
      promoInput.value = '';
      // В историю НЕ добавляем
      return;
    }

    // ============================================================
    // ОБЫЧНЫЕ ПРОМОКОДЫ
    // ============================================================
    const PROMO_CODES = {
      'GIFT10':    { desc: '+1000 ₽ на кошелёк',                       type: 'money',  amount: 1000 },
      '1000PROC':  { desc: 'Следующий закрут будет выигрышным',        type: 'guaranteed_win' },
      '1000KEY':   { desc: 'Следующий закрут будет иметь шанс 70%',    type: 'chance_70' },
      '10S':       { desc: 'Следующий закрут на 50 секунд',            type: 'long_spin', duration: 50000 },
      '6767':      { desc: '+67 ₽ на кошелёк',                         type: 'money',  amount: 67 }
    };

    if (!PROMO_CODES[upper]) {
      promoMsg.textContent = '❌ Промокод не найден';
      promoMsg.className = 'promo-msg err';
      return;
    }

    if (usedCodes.has(upper)) {
      promoMsg.textContent = '❌ Этот промокод уже активирован';
      promoMsg.className = 'promo-msg err';
      return;
    }

    const p = PROMO_CODES[upper];
    if (p.type === 'money') {
      wallet += p.amount;
      updateWallet();
      promoMsg.textContent = `✅ +${p.amount} ₽ зачислено на кошелёк!`;
    } else if (p.type === 'guaranteed_win') {
      activeEffects.guaranteedWin = true;
      activeEffects.chance70 = false;
      promoMsg.textContent = '✅ Следующий закрут будет выигрышным!';
    } else if (p.type === 'chance_70') {
      activeEffects.chance70 = true;
      activeEffects.guaranteedWin = false;
      promoMsg.textContent = '✅ Следующий закрут будет иметь шанс 70%!';
    } else if (p.type === 'long_spin') {
      activeEffects.longSpin = true;
      promoMsg.textContent = '✅ Следующий закрут будет длиться 50 секунд!';
    }

    usedCodes.set(upper, { desc: p.desc });
    promoMsg.className = 'promo-msg ok';
    promoInput.value = '';
    renderPromoHistory();
    updateActiveEffectsUI();
  }

  promoApplyBtn.addEventListener('click', applyPromo);
  promoInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') applyPromo();
  });

  // ============================================================
  // КЕЙСЫ
  // ============================================================
  const CASES = {
    wood:      { name: 'Wood Case',      emoji: '🪵', price: 1,    tier: 1, desc: 'Старт' },
    stone:     { name: 'Stone Case',     emoji: '🪨', price: 3,    tier: 1, desc: 'Камень' },
    bronze:    { name: 'Bronze Case',    emoji: '📦', price: 5,    tier: 2, desc: 'Бронза' },
    silver:    { name: 'Silver Case',    emoji: '🎁', price: 10,   tier: 2, desc: 'Серебро' },
    iron:      { name: 'Iron Case',      emoji: '⚙️', price: 15,   tier: 2, desc: 'Железо' },
    gold:      { name: 'Gold Case',      emoji: '💎', price: 25,   tier: 3, desc: 'Золото' },
    emerald:   { name: 'Emerald Case',   emoji: '🟢', price: 35,   tier: 3, desc: 'Изумруд' },
    sapphire:  { name: 'Sapphire Case',  emoji: '🔵', price: 50,   tier: 3, desc: 'Сапфир' },
    ruby:      { name: 'Ruby Case',      emoji: '🔴', price: 75,   tier: 4, desc: 'Рубин' },
    platinum:  { name: 'Platinum Case',  emoji: '🔷', price: 100,  tier: 4, desc: 'Платина' },
    obsidian:  { name: 'Obsidian Case',  emoji: '⚫', price: 150,  tier: 4, desc: 'Обсидиан' },
    diamond:   { name: 'Diamond Case',   emoji: '💠', price: 250,  tier: 5, desc: 'Алмаз' },
    crystal:   { name: 'Crystal Case',   emoji: '🔮', price: 350,  tier: 5, desc: 'Кристалл' },
    dragon:    { name: 'Dragon Case',    emoji: '🐉', price: 500,  tier: 5, desc: 'Дракон' },
    legend:    { name: 'Legend Case',    emoji: '🏆', price: 750,  tier: 6, desc: 'Легенда' },
    titan:     { name: 'Titan Case',     emoji: '⚡', price: 1000, tier: 6, desc: 'Титан' },
    phoenix:   { name: 'Phoenix Case',   emoji: '🔥', price: 1500, tier: 6, desc: 'Феникс' },
    mythic:    { name: 'Mythic Case',    emoji: '⭐', price: 2500, tier: 7, desc: 'Миф' },
    celestial: { name: 'Celestial Case', emoji: '🌟', price: 3500, tier: 7, desc: 'Небеса' },
    divine:    { name: 'Divine Case',    emoji: '✨', price: 5000, tier: 8, desc: 'Божество' },
    infinity:  { name: 'Infinity Case',  emoji: '♾️', price: 10000, tier: 9, desc: 'Бесконечность' }
  };

  function prizeRarity(prize, casePrice) {
    const ratio = prize / casePrice;
    if (ratio <= 0.5)  return 'common';
    if (ratio <= 1.0)  return 'uncommon';
    if (ratio <= 2.0)  return 'rare';
    if (ratio <= 4.0)  return 'epic';
    return 'legend';
  }

  function pickCasePrize(caseId) {
    const caseDef = CASES[caseId];
    const prizes = PRIZES[caseId];
    const price = caseDef.price;

    const profitable = prizes.filter(p => p >= price);
    const losing = prizes.filter(p => p < price);
    const isProfit = Math.random() < currentWinChance;

    if (isProfit && profitable.length > 0) {
      const weights = profitable.map(p => 1 / (p - price + 1));
      const total = weights.reduce((a,b)=>a+b,0);
      let r = Math.random() * total;
      for (let i = 0; i < profitable.length; i++) {
        r -= weights[i];
        if (r <= 0) return profitable[i];
      }
      return profitable[0];
    } else if (losing.length > 0) {
      const weights = losing.map(p => p);
      const total = weights.reduce((a,b)=>a+b,0);
      let r = Math.random() * total;
      for (let i = 0; i < losing.length; i++) {
        r -= weights[i];
        if (r <= 0) return losing[i];
      }
      return losing[0];
    }
    return prizes[Math.floor(Math.random() * prizes.length)];
  }

  function renderCaseItem(prize, casePrice) {
    const rar = prizeRarity(prize, casePrice);
    return `<div class="case-item rar-${rar}">
      <div class="ci-emoji">💰</div>
      <div class="ci-name">Деньги</div>
      <div class="ci-price">${prize} ₽</div>
    </div>`;
  }

  function renderCases() {
    casesList.innerHTML = '';
    Object.keys(CASES).forEach(id => {
      const c = CASES[id];
      const card = document.createElement('div');
      card.className = 'case-card c-tier-' + c.tier;
      card.dataset.case = id;
      card.innerHTML = `
        <div class="emoji">${c.emoji}</div>
        <div class="name">${c.name}</div>
        <div class="price">${c.price} ₽</div>
        <div class="desc">${c.desc}</div>
      `;
      card.addEventListener('click', () => openCase(id));
      casesList.appendChild(card);
    });
  }

  function openCase(caseId) {
    if (spinning) return;
    const caseDef = CASES[caseId];
    if (!caseDef) return;
    if (wallet < caseDef.price) {
      alert('Недостаточно средств для открытия кейса!');
      return;
    }

    wallet -= caseDef.price;
    updateWallet();

    caseOverlay.classList.add('show');
    caseClose.disabled = true;
    caseTitle.textContent = caseDef.emoji + ' ' + caseDef.name;
    caseSubtitle.textContent = `Цена: ${caseDef.price} ₽`;
    caseResult.textContent = '';
    caseResult.className = 'case-result';

    const winPrize = pickCasePrize(caseId);
    const prizes = PRIZES[caseId];

    const TOTAL_ITEMS = 60;
    const WIN_POS = 45;
    caseTrack.innerHTML = '';
    for (let i = 0; i < TOTAL_ITEMS; i++) {
      let prize;
      if (i === WIN_POS) prize = winPrize;
      else prize = prizes[Math.floor(Math.random() * prizes.length)];
      caseTrack.insertAdjacentHTML('beforeend', renderCaseItem(prize, caseDef.price));
    }

    caseTrack.style.transition = 'none';
    caseTrack.style.transform = 'translateX(0)';
    void caseTrack.offsetWidth;

    const ITEM_W = 120;
    const viewportHalf = caseTrack.parentElement.clientWidth / 2;
    const itemCenter = WIN_POS * ITEM_W + ITEM_W / 2;
    const jitter = (Math.random() - 0.5) * 70;
    const translateX = -(itemCenter - viewportHalf + jitter);

    caseTrack.style.transition = 'transform 8s cubic-bezier(.17,.67,.2,1)';
    caseTrack.style.transform = `translateX(${translateX}px)`;

    setTimeout(() => {
      caseClose.disabled = false;
      caseClose.textContent = `Забрать ${winPrize} ₽`;

      const profit = winPrize - caseDef.price;
      if (profit >= 0) {
        caseResult.textContent = `✅ Окуп! +${profit.toFixed(2)} ₽ профита`;
        caseResult.className = 'case-result profit';
      } else {
        caseResult.textContent = `❌ Убыток: ${profit.toFixed(2)} ₽`;
        caseResult.className = 'case-result lose';
      }

      caseClose.onclick = () => {
        wallet += winPrize;
        updateWallet();
        caseOverlay.classList.remove('show');
      };
    }, 8100);
  }

  // ============================================================
  // СТАРТ
  // ============================================================
  drawWheel(75);
  updateWallet();
  updateChanceDisplay();
  renderCases();
  renderPromoHistory();
  updateActiveEffectsUI();
</script>
</body>
</html>
